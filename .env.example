# Microsoft Entra ID (Azure AD) OAuth Client ID for Minecraft Authentication
# Required for Microsoft account login (RFC 8252 Public Client / PKCE)
SZZ_MSA_CLIENT_ID=

# Remote server catalog endpoint URL
# SZZ_CATALOG_URL=http://127.0.0.1:8080/catalog.json

# Custom root directory for SZZ storage (defaults to ~/.szz)
# SZZ_HOME=

# CurseForge for Studios API Key
# Obtain a personal key at: https://console.curseforge.com
CURSEFORGE_API_KEY=
